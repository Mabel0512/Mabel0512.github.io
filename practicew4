<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Single Page</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: white;
        }

        /* =========================
           Banner
        ========================= */
        .banner {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 120px;

            background: rgba(245, 238, 220, 0.85);

            color: #444;
            font-size: 24px;
            font-weight: normal;

            padding: 15px;

            z-index: 10;
        }

        /* =========================
           Information
        ========================= */
        .information {
            position: fixed;
            top: 0;
            right: 0;

            width: 140px;
            height: 100px;

            background: #ffc0cb;

            color: #333;
            font-size: 18px;
            font-weight: 300;

            padding: 10px;

            z-index: 20;
        }

        /* =========================
           Left Navigator
        ========================= */
        .navigator {
            position: fixed;
            top: 120px;
            left: 0;

            width: 150px;

            background: #d3d3d3;

            padding: 10px;

            z-index: 5;
        }

        .navigator a {
            display: block;

            color: #0000ee;
            text-decoration: underline;

            font-size: 18px;
            line-height: 1.8;

            cursor: pointer;
        }

        /* =========================
           Main Content
        ========================= */
        main {
            margin-left: 150px;
            padding-top: 120px;

            position: relative;
            z-index: 15;
        }

        .scene {
            min-height: 700px;

            padding: 40px 50px;

            background: transparent;

            position: relative;
            z-index: 15;
        }

        .scene h1 {
            margin: 0;

            font-size: 64px;
            font-weight: normal;

            color: #222;

            position: relative;
            z-index: 15;
        }

        /* =========================
           Footer
        ========================= */
        footer {
            min-height: 180px;

            background: #808080;

            color: #000;

            padding: 15px;

            font-size: 20px;

            position: relative;
            z-index: 15;
        }
    </style>
</head>

<body>

    <!-- Banner -->
    <header class="banner">
        Here is Banner
    </header>

    <!-- Information -->
    <div class="information">
        Information
    </div>

    <!-- Navigator -->
    <nav class="navigator">
        <a href="#scene01">Scene01</a>
        <a href="#scene02">Scene02</a>
        <a href="#scene03">Scene03</a>
        <a href="#scene04">Scene04</a>
    </nav>

    <!-- Main Content -->
    <main>

        <section id="scene01" class="scene">
            <h1>Scene01</h1>
        </section>

        <section id="scene02" class="scene">
            <h1>Scene02</h1>
        </section>

        <section id="scene03" class="scene">
            <h1>Scene03</h1>
        </section>

        <section id="scene04" class="scene">
            <h1>Scene04</h1>
        </section>

    </main>

    <!-- Footer -->
    <footer>
        Here is footer
    </footer>

</body>
</html>
